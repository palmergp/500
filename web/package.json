{
  "name": "fh-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "wasm": "wasm-pack build ../crates/wasm --target web --release --out-dir ../../web/src/engine/pkg --out-name fh_wasm --no-pack",
