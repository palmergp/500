# Cache rules for the published copy (Cloudflare Pages reads this file; see scripts/publish.ps1).
# Hashed build files never change; the page, the service worker and its file list are checked on
# every visit, so an installed app finds a new version.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
/sw.js
  Cache-Control: no-cache
/precache.json
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
